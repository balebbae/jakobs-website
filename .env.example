# Neon Postgres. On Vercel, the Neon integration sets both of these for you.
DATABASE_URL=postgres://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct (non-pooled) connection, used only by `pnpm db:migrate`.
DATABASE_URL_UNPOOLED=postgres://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Vercel Blob (video uploads). Set automatically when a Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=
